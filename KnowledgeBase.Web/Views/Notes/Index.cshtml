@model List<KnowledgeBase.Data.NoteEntity>
@{
    ViewData["Title"] = "Knowledge Base";
}

<div class="text-center">
    <h1 class="display-4">Internal Knowledge Base</h1>
</div>

<div class="row">
    <div class="col-md-4">
        <h3>Add New Entry</h3>
        <form method="post" action="/Notes/Create">
            <div class="form-group">
                <label>Header</label>
                <input type="text" name="header" class="form-control" />
            </div>
            <div class="form-group">
                <label>Body Content</label>
                <textarea name="body" class="form-control" rows="3"></textarea>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Save Note</button>
        </form>
    </div>

    <div class="col-md-8">
        <h3>Search & Results</h3>
        <form method="get" action="/Notes/Index" class="mb-3">
            <div class="input-group">
                <input type="text" name="searchTerm" class="form-control" placeholder="Search by header..." />
                <button type="submit" class="btn btn-outline-secondary">Filter</button>
            </div>
        </form>

        @foreach (var item in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@item.Header</h5>
                    <div class="card-text">@Html.Raw(item.Body)</div>
                </div>
            </div>
        }
    </div>
</div>
