# .gitignore for ASP.NET Core / .NET projects
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
Thumbs.db

# Visual Studio Code
.vscode/
.vs/

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Logs
*.log

# Publish output
publish/

# Database
*.mdf
*.ldf

# Others
*.db
*.sqlite

# npm packages
node_modules/

# Environment files
.env
.env.*

# Backup & temp files
*~
*.tmp
*.bak
*.swp
*.swo

# Test results
TestResults/
